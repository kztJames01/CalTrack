{
  "name": "CalTrack",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.8.3",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@11.6.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-test-renderer": "19.1.0",
    "@types/react": "19.1.0",
    "lodash": "^4.17.21",
    "picomatch": "^2.3.2",
    "@angular-devkit/core": "19.2.23",
    "@angular-devkit/schematics": "19.2.23",
    "@angular-devkit/schematics-cli": "19.2.23",
    "@nestjs/config": {
      "lodash": "^4.17.21"
    },
    "@nestjs/cli": {
      "@angular-devkit/core": "19.2.23",
      "@angular-devkit/schematics": "19.2.23",
      "@angular-devkit/schematics-cli": "19.2.23"
    }
  },
  "dependencies": {
    "@apple/app-store-server-library": "^2.0.0",
    "@types/passport-google-oauth20": "^2.0.17",
    "apple-signin-auth": "^2.0.0",
    "google-auth-library": "^10.5.0",
    "passport-google-oauth20": "^2.0.0"
  }
}
